# Work-server Docker defaults. Copy to .env.work to override them.

# Public address used in generated application links. Set this to the server IP.
SERVER_HOST=127.0.0.1
# Host port published by the frontend. It avoids ports occupied on the work server:
# 3307, 4444, 5057, 8081, and 8888.
WORK_HTTP_PORT=8082

# PostgreSQL
POSTGRES_DB=resonance
POSTGRES_USER=resonance
POSTGRES_PASSWORD=resonance-work-password

# Application
JWT_SECRET=resonance-work-jwt-secret-change-before-sharing
JWT_EXPIRE_MINUTES=4320
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=adminadmin
RUN_MIGRATIONS_ON_STARTUP=true
RUN_STARTUP_DIGEST_TEST=false

# Bots are deliberately disabled: this deployment does not receive questions.
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@bot:example.com
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=
MATRIX_PASSWORD=
MATRIX_DM_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=ResonanceBot
TELEGRAM_PROXY_URL=

# Optional external integration.
KANBAN_API_BASE_URL=https://kanban.devds.ru/api
KANBAN_API_TOKEN=
KANBAN_TIMEOUT_SECONDS=20
KANBAN_BUNDLE_TASK_PAGE_SIZE=250
KANBAN_BUNDLE_CACHE_TTL_SECONDS=45
